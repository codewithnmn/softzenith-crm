# Copy to .env.local. All optional for local development.

# Backend base URL; /api/* is proxied there (default http://localhost:8081)
CRM_API_URL=

# Supabase phone OTP sign-in. Leave empty to use the backend's development login (phone only, no OTP).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key for the public enquiry form. Leave empty locally (no captcha).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
