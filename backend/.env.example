# Environment for the API. Local development needs none of these (see application.yml defaults);
# with the prod profile the DB_* and SUPABASE_URL values are required.
DB_URL=
DB_USER=
DB_PASSWORD=
SUPABASE_URL=
FRONTEND_URL=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Cloudflare Turnstile secret for the public enquiry form. Empty = captcha not required.
TURNSTILE_SECRET=
# SoftZenith platform admin (/platform). Secret: at least 32 random characters; required with the prod profile.
CRM_PLATFORM_JWT_SECRET=
# First platform admin, created on startup only when none exists. Password: at least 12 characters.
# Remove both after the first start; the account stays.
CRM_PLATFORM_ADMIN_USERNAME=
CRM_PLATFORM_ADMIN_PASSWORD=
