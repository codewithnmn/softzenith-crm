# Copy to .env.local. All optional for local development.

# CRM backend base URL; only the public enquiry endpoints are proxied there (default http://localhost:8081)
CRM_API_URL=
# CRM tenant slug the forms post to (default westernworld)
NEXT_PUBLIC_CRM_TENANT=
# Cloudflare Turnstile site key. Leave empty locally (no captcha).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
